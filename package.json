{
  "name": "react-native-divkit",
  "version": "1.11.2",
  "description": "DivKit renderer for React Native - Server-driven UI framework",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "adapters/*": ["dist/adapters/*"]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters/rn-image": {
      "types": "./dist/adapters/rn-image.d.ts",
      "import": "./dist/adapters/rn-image.js",
      "require": "./dist/adapters/rn-image.js",
      "default": "./dist/adapters/rn-image.js"
    },
    "./adapters/expo-image": {
      "types": "./dist/adapters/expo-image.d.ts",
      "import": "./dist/adapters/expo-image.js",
      "require": "./dist/adapters/expo-image.js",
      "default": "./dist/adapters/expo-image.js"
    },
    "./adapters/fast-image": {
      "types": "./dist/adapters/fast-image.d.ts",
      "import": "./dist/adapters/fast-image.js",
      "require": "./dist/adapters/fast-image.js",
      "default": "./dist/adapters/fast-image.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "typings",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:peggy && tsc && npm run build:copy-types",
    "build:peggy": "peggy src/expressions/expressions.peggy --allowed-start-rules start,JsonStringContents --format es -o src/expressions/expressions.ts && printf '%s\n%s\n' '// @ts-nocheck' \"$(cat src/expressions/expressions.ts)\" > src/expressions/expressions.ts",
    "build:copy-types": "node scripts/copy-types.js",
    "test": "jest",
    "test:snapshot": "jest --config jest.snapshot.config.js",
    "test:snapshot:update": "jest --config jest.snapshot.config.js -u",
    "test:integration": "jest --config jest.integration.config.js",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "verify:pack": "node scripts/verify-pack.js"
  },
  "keywords": [
    "divkit",
    "react-native",
    "server-driven-ui",
    "dynamic-ui",
    "mobile"
  ],
  "author": "Ruslan Pulatov",
  "license": "Apache-2.0",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "expo-image": "*",
    "react-native-fast-image": "*"
  },
  "peerDependenciesMeta": {
    "expo-image": {
      "optional": true
    },
    "react-native-fast-image": {
      "optional": true
    }
  },
  "dependencies": {
    "peggy": "^3.0.2"
  },
  "optionalDependencies": {
    "@react-native-clipboard/clipboard": "^1.13.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-svg": "^15.15.2"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@testing-library/react-native": "^12.0.0",
    "@types/jest": "^29.0.0",
    "@types/react": "^19.2.13",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.47.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.0.0",
    "react": "19.2.4",
    "react-native": "0.83.1",
    "react-test-renderer": "^19.2.0",
    "semantic-release": "^25.0.3",
    "ts-jest": "^29.0.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rpulatov/react-native-divkit.git"
  }
}
